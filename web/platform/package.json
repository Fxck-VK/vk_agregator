{
  "name": "@neirohub/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "public-copy:generate": "node scripts/public-copy-catalog.mjs --write",
    "public-copy:check": "node scripts/public-copy-catalog.mjs && node scripts/public-copy-sources.mjs",
    "public-pages:generate": "node scripts/public-page-manifest.mjs",
    "predev": "npm run public-pages:generate",
    "prebuild": "npm run public-copy:check && npm run public-pages:generate",
    "pretypecheck": "npm run public-copy:check && npm run public-pages:generate",
    "pretest": "npm run public-copy:check && npm run public-pages:generate",
    "pretest:i18n": "npm run public-copy:check && npm run public-pages:generate",
    "prelint": "npm run public-copy:check && npm run public-pages:generate",
    "dev": "next dev --port 7159",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:assets && npm run test:next-lint-contract && npm run test:public-pages && npm run test:public-copy",
    "test:public-copy": "node --test scripts/public-copy-catalog.test.mjs",
    "test:public-pages": "node --test scripts/public-page-manifest.test.mjs",
    "test:i18n": "vitest run src/i18n",
    "test:session-browser": "node --test scripts/test-session-recovery.mjs",
    "test:sign-in-browser": "node --test scripts/test-sign-in-browser.mjs",
    "test:assets": "node --test scripts/validate-assets.test.mjs",
    "test:next-lint-contract": "node --test scripts/validate-next-lint.test.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test:packaging": "node scripts/assert-packaging.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "vite": "8.2.4",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:glob@12.0.0"
    },
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
