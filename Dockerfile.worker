# syntax=docker/dockerfile:1

FROM golang:1.25.14-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
WORKDIR /src

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk add --no-cache ca-certificates tzdata ffmpeg 'giflib>=5.2.2-r2' 'libblkid>=2.41.6-r1' 'libmount>=2.41.6-r1' 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' 'libexpat>=2.8.5-r0' \
    && adduser -D -H -u 10001 appuser
WORKDIR /app

COPY --from=build /out/worker /app/worker
COPY --from=build /src/migrations /app/migrations

EXPOSE 9090
USER 10001
ENTRYPOINT ["/app/worker"]
