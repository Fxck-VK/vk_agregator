# syntax=docker/dockerfile:1

FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS build
WORKDIR /src

COPY web/miniapp/package.json web/miniapp/package-lock.json ./
RUN npm ci

COPY web/miniapp ./
RUN npm run build

FROM nginx:1.31.6-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
COPY --from=build /src/dist /usr/share/nginx/html
COPY deployments/nginx/miniapp.static.conf /etc/nginx/conf.d/default.conf
RUN apk add --no-cache 'libuuid>=2.42.3-r1' 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' 'libexpat>=2.8.5-r0' 'pcre2>=10.49-r0' \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080
