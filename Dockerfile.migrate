# syntax=docker/dockerfile:1

FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS build
WORKDIR /src

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk add --no-cache ca-certificates tzdata 'musl>=1.2.5-r13' 'musl-utils>=1.2.5-r13' 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' 'zlib>=1.3.2-r1' \
    && adduser -D -H -u 10001 appuser
WORKDIR /app

COPY --from=build /out/migrate /app/migrate
COPY migrations /app/migrations

USER 10001
ENTRYPOINT ["/app/migrate"]
CMD ["up"]
