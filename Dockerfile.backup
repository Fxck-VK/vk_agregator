# syntax=docker/dockerfile:1

FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS objectsync-build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/objectsync ./cmd/objectsync
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/objectsync ./cmd/objectsync

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

RUN apk add --no-cache bash ca-certificates coreutils findutils 'postgresql18-client>=18.7-r0' 'libpq>=18.7-r0' 'musl>=1.2.5-r24' 'musl-utils>=1.2.5-r24' 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' 'zlib>=1.3.2-r1' \
    && addgroup -S backup \
    && adduser -S -G backup backup

WORKDIR /app
ENV PATH="/app:${PATH}"
COPY --from=objectsync-build /out/objectsync /app/objectsync
COPY scripts/backup /app/scripts/backup
RUN chmod +x /app/scripts/backup/*.sh \
    && mkdir -p /backups /backup-metrics \
    && chown -R backup:backup /app /backups /backup-metrics

USER backup

CMD ["/app/scripts/backup/backup-postgres.sh"]
