# syntax=docker/dockerfile:1

FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS objectsync-build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/objectsync ./cmd/objectsync
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/objectsync ./cmd/objectsync

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache bash ca-certificates coreutils findutils postgresql-client 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' \
    && addgroup -S backup \
    && adduser -S -G backup backup

WORKDIR /app
ENV PATH="/app:${PATH}"
COPY --from=objectsync-build /out/objectsync /app/objectsync
COPY scripts/backup /app/scripts/backup
RUN chmod +x /app/scripts/backup/*.sh \
    && mkdir -p /backups /backup-metrics \
    && chown -R backup:backup /app /backups /backup-metrics

USER backup

CMD ["/app/scripts/backup/backup-postgres.sh"]
